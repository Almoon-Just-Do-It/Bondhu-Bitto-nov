{
  "name": "bondhu-bitto",
  "version": "1.0.0",
  "private": true,
  "description": "BonDhu Bitto monthly savings and kisti management system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:worker": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply bondhu-bitto --remote",
    "db:migrate:local": "wrangler d1 migrations apply bondhu-bitto --local"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hono": "^4.13.18",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "wrangler": "^4.162.0"
  }
}
